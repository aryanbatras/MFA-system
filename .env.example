# -----------------------------------------------------------------------------
# MFA System environment
# Copy to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Better Auth signs sessions and encrypts TOTP secrets with this value.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical URL of this deployment. Use http://localhost:3001 for local dev if
# port 3000 is already in use. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional. Used by the server when NEXT_PUBLIC_APP_URL is not set.
# BETTER_AUTH_URL=http://localhost:3001

# Turso Cloud (LibSQL). Create a database at https://app.turso.tech.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Resend transactional email. Create a key at https://resend.com/api-keys.
# EMAIL_FROM must use a sender on a domain verified in Resend. This deployment
# uses the verified 100xsystems.dev domain.
RESEND_API_KEY=
EMAIL_FROM=MFA System <noreply@100xsystems.dev>

# Pexels API key for the single editorial photograph on the auth screen.
# Server-side only; do not prefix this with NEXT_PUBLIC_.
PEXELS_API_KEY=

# Optional comma-separated additional trusted origins for Better Auth.
# Example: https://staging.example.com,https://app.example.com
TRUSTED_ORIGINS=
